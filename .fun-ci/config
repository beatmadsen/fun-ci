# The renderer's Cargo.toml is in renderer/, where the cargo presets don't look
# for it, so the stages that run cargo name them.
evidence:
  stages:
    lint:
      - use: section
        preset: rustc
    build:
      - use: section
        preset: rustc
    slow:
      - use: section
        preset: cargo-test
      # The mutation lane's verdict: what mutineer says went wrong, and its summary.
      - use: grep
        title: mutineer
        patterns: ["^mutineer: ", "^FAILED: ", "^\\[mutineer\\] .* no verdict", "^Mutation score: ", "^Survived: "]
